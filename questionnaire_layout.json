{
  "name": "test_questionnaire_v1",
  "description": "Пример разметки анкеты. Координаты заданы в миллиметрах от центра левого верхнего маркера.",
  "coordinate_system": {
    "origin": "top_left_marker_center",
    "x_axis": "to_top_right_marker",
    "y_axis": "to_bottom_left_marker",
    "unit": "mm"
  },
  "marker_box_mm": {
    "width": 170.0,
    "height": 260.0
  },
  "answer_grid": {
    "left_mm": 25.0,
    "first_separator_y_mm": 55.0,
    "table_step_y_mm": 25.0,
    "tables": 4,
    "columns": 11,
    "cell_mm": {
      "width": 10.0,
      "height": 10.0
    },
    "rows": [
      {
        "id": "printed",
        "label": "Напечатанный символ",
        "y_offset_from_separator_mm": -10.0
      },
      {
        "id": "answer",
        "label": "Ответ пользователя",
        "y_offset_from_separator_mm": 0.0
      }
    ]
  }
}
